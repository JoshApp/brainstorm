{
  "name": "delve",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "verify": "tsc --noEmit",
    "test": "tsx tests/combat-math.test.ts && tsx tests/floor-determinism.test.ts && tsx tests/item-format.test.ts && tsx tests/affix.test.ts && tsx tests/content-load.test.ts && tsx tests/vault-validate.test.ts && tsx tests/floor-invariants.test.ts && tsx tests/opening.test.ts && tsx tests/loot.test.ts && tsx tests/stamina.test.ts && tsx tests/swing-state.test.ts",
    "ship": "bash scripts/ship.sh",
    "live": "bash scripts/live.sh",
    "watch-deploy": "bash scripts/watch-deploy.sh",
    "gen-patchlog": "tsx scripts/gen-patchlog.ts",
    "prebuild": "tsx scripts/gen-patchlog.ts",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "snap": "tsx scripts/snap.ts",
    "perf": "tsx scripts/perf.ts",
    "harness-smoke": "tsx scripts/harness-smoke.ts",
    "harness-continue": "tsx scripts/harness-continue.ts",
    "play": "tsx scripts/play.ts",
    "pilot": "tsx scripts/pilot.ts",
    "reach": "tsx scripts/reach.ts",
    "delve": "tsx scripts/delve.ts"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.160.0",
    "playwright": "^1.60.0",
    "tsx": "^4.22.3",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.17.0"
  }
}
