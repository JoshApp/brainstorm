#!/usr/bin/env bash
# Pre-push safety net: typecheck before anything reaches CI.
#
# The GitHub Pages deploy runs `tsc && vite build`; the overwhelming
# majority of red deploys are TypeScript errors, which `tsc --noEmit`
# catches here in a few seconds — before the push, before CI, before
# the live URL goes stale. Catching it locally is the fastest possible
# feedback: the failure never happens.
#
# Skips itself if tsc isn't installed (e.g. a clone without npm ci).
# Set SKIP_PREPUSH=1 to bypass for an emergency push.

set -euo pipefail

if [ "${SKIP_PREPUSH:-}" = "1" ]; then
  echo "[pre-push] SKIP_PREPUSH=1 — skipping typecheck"
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

if [ ! -x node_modules/.bin/tsc ]; then
  echo "[pre-push] tsc not found (run npm ci) — skipping typecheck"
  exit 0
fi

echo "[pre-push] typechecking…"
if ! node_modules/.bin/tsc --noEmit; then
  echo ""
  echo "[pre-push] ✗ typecheck FAILED — push aborted."
  echo "           Fix the errors above, or SKIP_PREPUSH=1 git push to force."
  exit 1
fi
echo "[pre-push] ✓ typecheck passed"

# PARSE the files tsc does not look at. `tsconfig.json` includes "src" only, so
# scripts/ and tests/ are entirely unchecked — and on 2026-08-08 two scripts were
# pushed with a stray `}` in them, past a green tsc and a green test run, because
# nothing had ever parsed them. `delve` and `inventory` were simply broken until
# someone ran them.
#
# This is a SYNTAX check, not a typecheck: those trees carry ~88 pre-existing
# type errors and demanding they be clean would just get this hook bypassed. A
# file that cannot be parsed is a different class of problem — it is broken for
# everybody, always — and esbuild finds it across every script and test in under
# a second.
if [ -x node_modules/.bin/esbuild ]; then
  if ! node_modules/.bin/esbuild scripts/*.ts tests/*.ts --outdir="$(mktemp -d)" --log-level=error >/dev/null; then
    echo ""
    echo "[pre-push] ✗ a script or test does not PARSE — push aborted."
    exit 1
  fi
  echo "[pre-push] ✓ scripts + tests parse"
fi

# Tests — catch what tsc can't: a module that THROWS at runtime init (a
# reserved/duplicate enemy tile char white-screened the live game once;
# tsc + vite build don't execute the module, the test suite does), plus
# composer invariants (vault overlap, unreachable stairs) and vault
# structure. Skipped if tsx isn't installed.
#
# Usually FREE: `npm test` short-circuits when the tree's content hash matches
# the last full pass, which is the normal case here — you just ran it. When it
# does run it is ~60s (parallel, one process per file). FORCE_TESTS=1 re-runs.
if [ -x node_modules/.bin/tsx ]; then
  echo "[pre-push] running tests…"
  if ! npm test --silent; then
    echo ""
    echo "[pre-push] ✗ tests FAILED — push aborted."
    echo "           Fix the failures above, or SKIP_PREPUSH=1 git push to force."
    exit 1
  fi
  echo "[pre-push] ✓ tests passed"
else
  echo "[pre-push] tsx not found (run npm ci) — skipping tests"
fi
exit 0
